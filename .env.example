# Example environment variables for the purchase server
# Copy to .env and fill values (DO NOT commit your real keys)

# Telegram bot token (from BotFather)
BOT_TOKEN=your_bot_token_here

# If you want the server to register a webhook, set PUBLIC_URL to your HTTPS URL
# e.g. PUBLIC_URL=https://mydomain.example.com
PUBLIC_URL=

# Optional: Postgres connection string (direct DB access)
# e.g. DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Optional: Supabase settings (service role key used server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: simple API key for client -> server proxy calls
CLIENT_API_KEY=

# Optional: port override
PORT=3001
