{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sokoban-cloudflare-api",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_ENV": "development",
    "CLIENT_API_KEY": "replace-with-your-client-api-key"
  }
}
